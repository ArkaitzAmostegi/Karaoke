/.venv

# El audio no se versiona: pesa mucho y no es nuestro.
# Sin barra, la regla vale en CUALQUIER carpeta (tambien en canciones/_sin_letra/).
# Con "canciones/*.mp3" un solo * no atraviesa subcarpetas y se colaban.
*.mp3
*.ogg

# Los .lrc SI se versionan: son trabajo tuyo y ocupan nada.
# Pero NO los ficheros de trabajo del re-cronometrado:
*.lrc.old
*.lrc.nuevo
*.viejo
*.original
*.convertido
canciones/_originales/
canciones/_aparcadas/

# Registros y salidas de las tandas de sincronizacion
*.log
*.err
informe_sincronizacion.txt

# Basura de Python
__pycache__/